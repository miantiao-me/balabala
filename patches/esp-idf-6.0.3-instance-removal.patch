+/* Restart the search after each removal: empty id/base/loop ancestors may
+ * have been freed. Legacy nodes belong to their queued cleanup and are skipped. */
+static void remove_deferred_instances(esp_event_loop_instance_t *loop)
+{
+    esp_event_remove_handler_context_t ctx = {.loop = loop, .legacy = false};
+    while (true) {
+        esp_event_loop_node_t *loop_node;
+        esp_event_base_node_t *base_node;
+        esp_event_id_node_t *id_node;
+        esp_event_handler_node_t *handler;
+        SLIST_FOREACH(loop_node, &loop->loop_nodes, next) {
+            ctx.event_base = esp_event_any_base;
+            ctx.event_id = ESP_EVENT_ANY_ID;
+            SLIST_FOREACH(handler, &loop_node->handlers, next) {
+                if (handler->deferred_instance_remove) {
+                    goto remove;
+                }
+            }
+            SLIST_FOREACH(base_node, &loop_node->base_nodes, next) {
+                ctx.event_base = base_node->base;
+                ctx.event_id = ESP_EVENT_ANY_ID;
+                SLIST_FOREACH(handler, &base_node->handlers, next) {
+                    if (handler->deferred_instance_remove) {
