+                    ctx.event_id = id_node->id;
+                    SLIST_FOREACH(handler, &id_node->handlers, next) {
+                        if (handler->deferred_instance_remove) {
+                            goto remove;
+                        }
+                    }
+                }
+            }
+        }
+        return;
+remove:
+        ctx.handler_ctx = handler->handler_ctx;
+        esp_err_t err = loop_remove_handler(&ctx);
+        assert(err == ESP_OK);
+    }
 }
 
