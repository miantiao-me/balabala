+            2 => 1,
+            v if v == fa::VERSION => *bytes.get(14)?,
+            _ => return None,
+        };
+        let count = rd_u16(bytes, 6)? as usize;
+        let cell_w = *bytes.get(8)? as u32;
+        let cell_h = *bytes.get(9)? as u32;
+        let baseline = *bytes.get(10)? as u32;
+        let line_height = *bytes.get(11)? as u32;
+        let slot = *bytes.get(12)?;
+        let flags = *bytes.get(13)?;
+        if density == 0 || count == 0 || cell_w == 0 || cell_h == 0 || slot as usize >= spec::MAX_FONT_SLOTS { return None; }
+        let bitmap_off = count.checked_mul(fa::CMAP_ENTRY_SIZE)?.checked_add(fa::HEADER_SIZE)?;
+        let cell_bytes = (cell_w as usize).checked_mul(cell_h as usize)?.checked_mul(density as usize)?.checked_mul(density as usize)?;
+        let end = bitmap_off.checked_add(count.checked_mul(cell_bytes)?)?;
+        bytes.get(..end)?;
+        let mut previous = None;
+        for i in 0..count {
+            let off = fa::HEADER_SIZE + i * fa::CMAP_ENTRY_SIZE;
+            let cp = rd_u32(bytes, off)?;
+            if previous.is_some_and(|p| p >= cp) || rd_u16(bytes, off + 4)? as usize >= count { return None; }
+            previous = Some(cp);
+        }
+        let find = |ch: char| -> Option<usize> {
+            let mut lo = 0; let mut hi = count;
+            while lo < hi {
+                let mid = (lo + hi) / 2;
+                if rd_u32(bytes, fa::HEADER_SIZE + mid * fa::CMAP_ENTRY_SIZE)? < ch as u32 { lo = mid + 1; } else { hi = mid; }
+            }
+            let off = fa::HEADER_SIZE + lo * fa::CMAP_ENTRY_SIZE;
+            (lo < count && rd_u32(bytes, off)? == ch as u32).then_some(off)
+        };
