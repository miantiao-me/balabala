+            bitmap.extend_from_slice(bytes.get(start..start + cell_bytes)?);
+        }
+        Some(Atlas { cell_w, cell_h, texture_cell_w: cell_w, baseline, line_height,
+            raster_density: density, slot, flags, glyph_count: chars.len() as u16, cmap, stream: None, bitmap })
+    }
