+    /// Construct only the selected final cmap/bitmap from an immutable archive.
+    /// Codepoints must be nonempty, sorted and unique. No serialized subset copy.
+    pub fn subset(bytes: &[u8], chars: &[char]) -> Option<Atlas> {
+        use spec::font_atlas as fa;
+        if rd_u32(bytes, 0)? != fa::MAGIC || chars.is_empty() || chars.len() > u16::MAX as usize
